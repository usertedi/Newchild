{
  "manifest_version": 3,
  "name": "SafeNet Guardian - Parental Control",
  "version": "1.0.0",
  "description": "Advanced parental control extension with multi-language support and offline protection",
  "permissions": [
    "webRequest",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SafeNet Guardian"
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["warning.html", "rules.json", "update-rules.json"],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
